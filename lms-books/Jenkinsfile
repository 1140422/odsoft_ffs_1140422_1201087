pipeline {
  agent any

  tools {
    maven 'Maven3'
    jdk 'Java21'
  }

  environment {
    APP_NAME = "lms-books"
    DOCKER_IMAGE = "lms-books"
    DOCKER_TAG = "latest"
  }

  stages {

    stage('Checkout') {
                steps {
                    checkout scm
                }
            }

            stage('Build') {
                steps {
                    dir('lms-books') {
                        script {
                            if (isUnix()) {
                                sh 'mvn clean compile -DskipTests'
                            } else {
                                bat 'mvn clean compile -DskipTests'
                            }
                        }
                    }
                }
            }

            stage('Static Code Analysis') {
                steps {
                    dir('lms-books') {
                        script {
                            if (isUnix()) {
                                sh 'mvn checkstyle:check spotbugs:spotbugs -DskipTests'
                            } else {
                                bat 'mvn checkstyle:check spotbugs:spotbugs -DskipTests'
                            }
                        }
                    }
                }
                post {
                    always {
                        recordIssues tools: [
                            checkStyle(pattern: 'lms-books/target/checkstyle-result.xml'),
                            spotBugs(pattern: 'lms-books/target/spotbugsXml.xml')
                        ]
                    }
                }
            }

            stage('Packaging') {
                steps {
                    dir('lms-books') {
                        script {
                            if (isUnix()) {
                                sh 'mvn package -DskipTests'
                            } else {
                                bat 'mvn package -DskipTests'
                            }
                        }
                    }
                }
            }

            stage('Unit Tests') {
                steps {
                    dir('lms-books') {
                        script {
                            if (isUnix()) {
                                sh 'mvn test'
                            } else {
                                bat 'mvn test'
                            }
                        }
                    }
                }
                post {
                    always {
                        junit 'lms-books/target/surefire-reports/*.xml'
                        recordCoverage(tools: [[parser: 'JACOCO']],
                            id: 'jacoco', name: 'JaCoCo Coverage',
                            sourceCodeRetention: 'EVERY_BUILD',
                            qualityGates: [
                                [threshold: 10.0, metric: 'LINE', baseline: 'PROJECT', unstable: true],
                                [threshold: 2.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: true]
                            ])
                    }
                }
            }

            stage('Mutation Tests') {
                steps {
                    dir('lms-books') {
                        script {
                            if (isUnix()) {
                                sh 'mvn pitest:mutationCoverage'
                            } else {
                                bat 'mvn pitest:mutationCoverage'
                            }
                        }
                    }
                }
                post {
                    always {
                        publishHTML(target: [
                            allowMissing: true,
                            keepAll: true,
                            reportDir: 'psoft-project-2024-g1/target/pit-reports',
                            reportFiles: 'index.html',
                            reportName: 'Mutation Testing Report'
                        ])
                    }
                }
            }
  }

  post {
    success {
      echo "Pipeline OK — image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
    }
    failure {
      echo "Pipeline failed — check logs"
    }
  }
}
