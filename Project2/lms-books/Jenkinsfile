pipeline {
  agent any

  tools {
    maven 'Maven3'
    jdk 'Java21'
  }

  environment {
    APP_PATH = "Project2/lms-books"
    APP_NAME = "lms-books"
    DOCKER_IMAGE = "lmsbooks"
    DOCKER_REPO = "1140422/lmsbooks"
    DOCKER_TAG = "${BUILD_NUMBER}"
  }

  stages {

    stage('Checkout') {
                steps {
                    checkout scm
                }
            }

    stage('Build') {
        steps {
            dir("${APP_PATH}") {
                script {
                    if (isUnix()) {
                        sh 'mvn clean compile -DskipTests'
                    } else {
                        bat 'mvn clean compile -DskipTests'
                    }
                }
            }
        }
    }

    stage('Static Code Analysis') {
        steps {
            dir("${APP_PATH}") {
                script {
                    if (isUnix()) {
                        sh 'mvn checkstyle:check spotbugs:spotbugs -DskipTests'
                    } else {
                        bat 'mvn checkstyle:check spotbugs:spotbugs -DskipTests'
                    }
                }
            }
        }
        post {
            always {
                recordIssues tools: [
                    checkStyle(pattern: 'Project2/lms-books/target/checkstyle-result.xml'),
                    spotBugs(pattern: 'Project2/lms-books/target/spotbugsXml.xml')
                ]
            }
        }
    }

    stage('Packaging') {
        steps {
            dir("${APP_PATH}") {
                script {
                    if (isUnix()) {
                        sh 'mvn package -DskipTests'
                    } else {
                        bat 'mvn package -DskipTests'
                    }
                }
            }
        }
    }

    stage('Unit Tests') {
        steps {
            dir("${APP_PATH}") {
                script {
                    if (isUnix()) {
                        sh 'mvn test'
                    } else {
                        bat 'mvn test'
                    }
                }
            }
        }
        post {
            always {
                junit 'Project2/lms-books/target/surefire-reports/*.xml'
                recordCoverage(tools: [[parser: 'JACOCO']],
                    id: 'jacoco', name: 'JaCoCo Coverage',
                    sourceCodeRetention: 'EVERY_BUILD',
                    qualityGates: [
                        [threshold: 10.0, metric: 'LINE', baseline: 'PROJECT', unstable: true],
                        [threshold: 2.0, metric: 'BRANCH', baseline: 'PROJECT', unstable: true]
                    ])
            }
        }
    }

    stage('Mutation Tests') {
        steps {
            dir("${APP_PATH}") {
                script {
                    if (isUnix()) {
                        sh 'mvn pitest:mutationCoverage'
                    } else {
                        bat 'mvn pitest:mutationCoverage'
                    }
                }
            }
        }
        post {
            always {
                publishHTML(target: [
                    allowMissing: true,
                    keepAll: true,
                    reportDir: 'Project2/lms-books/target/pit-reports',
                    reportFiles: 'index.html',
                    reportName: 'Mutation Testing Report'
                ])
            }
        }
    }

    stage('CDC Tests') {
      steps {
        dir("${APP_PATH}") {
          script {
            if (isUnix()) {
              sh 'mvn -Dtest=BooksCDCDefinitionTest test'
              sh 'mvn -Dit.test=BooksProducerCDCIT verify -DskipTests=true -DskipIT=false'
            } else {
              bat 'mvn -Dtest=BooksCDCDefinitionTest test'
              bat 'mvn -Dit.test=BooksProducerCDCIT verify -DskipTests=true -DskipIT=false'
            }
          }
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'Project2/lms-books/target/pacts/**',
                           fingerprint: true,
                           allowEmptyArchive: true
        }
      }
    }

    stage('Container image build') {
        steps {
            dir("${APP_PATH}") {
                script {
                    if (isUnix()) {
                      sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                    } else {
                        bat "docker build -t %DOCKER_IMAGE%:%DOCKER_TAG% ."
                    }
                }
            }
        }
    }

    stage('Docker Login & Push') {
        steps {
            sh "docker build -t $DOCKER_IMAGE:latest ."
            withCredentials([usernamePassword(
                credentialsId: 'dockerhub-credentials',
                usernameVariable: 'DOCKER_USER',
                passwordVariable: 'DOCKER_PASS'
            )]) {
                sh """
                    docker login -u $DOCKER_USER -p $DOCKER_PASS
                    docker tag $DOCKER_IMAGE:latest $DOCKER_REPO:$DOCKER_TAG
                    docker tag $DOCKER_IMAGE:latest $DOCKER_REPO:latest
                    docker push $DOCKER_REPO:$DOCKER_TAG
                    docker push $DOCKER_REPO:latest
                """
            }
        }
    }

    stage('Staging Deployment (Local)') {
        steps {
            dir("${APP_PATH}") {
                sh """
                    echo "Stopping any existing staging containers..."
                    docker compose down || true
                    
                    echo "Starting staging environment locally..."
                    docker compose up -d --build
                    
                    echo "Listing running containers for staging..."
                    docker ps
                """
            }
        }
        post {
            always {
                echo "Local staging deployment attempted."
            }
            success {
                echo "Local staging environment is up and running!"
            }
            failure {
                echo "Local staging deployment failed — check logs."
            }
        }
    }

    stage('Notify for Manual Approval') {
      steps {
        emailext(
          to: '1201087@isep.ipp.pt',
          subject: "Jenkins Approval Required: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
          body: """
            The build is ready for DEPLOYMENT (Service B - LMS Books).

            Job: ${env.JOB_NAME}
            Build: #${env.BUILD_NUMBER}
            Link: ${env.BUILD_URL}

            Please approve the deployment in Jenkins (manual input step).
            """
        )
      }
    }

    stage('Manual Approval (Service B)') {
      steps {
        input(
          message: "Approve deployment of Service B (LMS Books)?",
          ok: "Approve and continue"
        )
      }
    }

    stage('Deploy to Remote Server') {
        steps {
            sshagent(credentials: ['home-server-ssh']) {
            sh """
                scp -o StrictHostKeyChecking=no Project2/lms-authnusers/docker-compose.yml nuno@192.168.1.200:/opt/lms/docker-compose.yml
                ssh -o StrictHostKeyChecking=no nuno@192.168.1.200 'cd /opt/lms && docker compose -f docker-compose.yml pull && docker compose -f docker-compose.yml up -d'
            """
            }
        }
    }
  }

  post {
    success {
      echo "Pipeline OK - image: ${DOCKER_IMAGE}:${DOCKER_TAG}"
    }
    failure {
      echo "Pipeline failed — check logs"
    }
  }
}
